{
  "name": "digit-show-webview",
  "version": "5.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx vite dev",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun run typecheck && bunx vite build",
    "preview": "bunx vite preview",
    "serve:generate": "bun run serve/generate-embed.ts",
    "serve:build": "bun run serve/build.ts",
    "electronbun:dev": "electrobun dev",
    "electronbun:build": "electrobun build"
  },
  "dependencies": {
    "@fontsource/iosevka": "^5.3.0",
    "plotly.js": "^3.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plotly.js": "^4.1.0",
    "react-rnd": "^10.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/plotly.js": "^3.0.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "electrobun": "^1.18.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
